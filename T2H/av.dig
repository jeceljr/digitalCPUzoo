<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes>
    <entry>
      <string>Description</string>
      <string>This uses a 4K x 16 bit external memory to generate the timing for a 1280x720 image with
80x30 characters, each 16x26 pixels in size. It also generates a new 16 bit audio sample
on each horizontal line (45 KHz)</string>
    </entry>
    <entry>
      <string>Label</string>
      <string>AudioVideo</string>
    </entry>
